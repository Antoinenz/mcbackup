# --- Cloudflare R2 (R2 > Manage API tokens > create token with Object Read & Write on bucket "game")
RESTIC_REPOSITORY=s3:https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com/game
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# --- restic encryption password. KEEP A COPY SOMEWHERE SAFE: without it every backup is unreadable.
RESTIC_PASSWORD=

# --- MCSManager panel API key (panel > user menu > API key). Used for save-off/save-all flush.
MCSM_URL=http://127.0.0.1:23333
MCSM_APIKEY=
